// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. USER & AUTHENTICATION (SaaS Multi-tenant)
// ==========================================
model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  
  // ROLES: "CUSTOMER", "VENDOR", "ADMIN"
  role              String    @default("CUSTOMER")
  
  // PROFILE & SAAS VENDOR CONFIG
  phoneNumber       String?  
  companyName       String?   // For Vendors/Business Customers
  gstin             String?   // Mandatory for B2B/Vendors
  address           String?  
  gender            String?
  birthday          String?
  alternatePhone    String?
  isVerifiedVendor  Boolean   @default(false)
  commissionRate    Float     @default(10.0) // Platform percentage cut (e.g., 10%)
  image             String?
  walletBalance     Float     @default(0.0)
  signature         String?   // Vendor digital authorized signature
  bankDetails       String?   // Vendor bank details for payout settlements
  razorpayAccountId String?   // Vendor's Razorpay Linked Account ID (acc_xxxx)
  
  // KYC Database Fields
  aadhaarNumber     String?
  panNumber         String?
  kycStatus         String    @default("PENDING") // "PENDING", "VERIFIED", "REJECTED"
  kycDocUrl         String?
  
  // SECURITY
  emailVerified     DateTime?
  verificationToken String?   @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // RELATIONS
  orders            RentalOrder[] 
  products          Product[]     // Vendor's Halls/Products
  reviews           Review[]      // Reviews left by this user
  auditLogs         AuditLog[]
  walletTransactions WalletTransaction[]
  wishlist          WishlistItem[]
  notifications     Notification[]
  coupons           Coupon[]
}

// ==========================================
// 2. VENUE & HALL MANAGEMENT (Product base)
// ==========================================
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?   
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] 
}

model Product {
  id              String   @id @default(uuid())
  
  // VENDOR LINK (Tenant)
  vendorId        String?  
  vendor          User?    @relation(fields: [vendorId], references: [id])

  name            String
  description     String?
  
  categoryId      String?  
  category        Category? @relation(fields: [categoryId], references: [id])

  // RENTAL PRICING
  priceHourly     Float    @default(0)
  priceDaily      Float    @default(0) // Primary rate
  priceWeekly     Float    @default(0)
  securityDeposit Float    @default(0)
  
  // HALL-SPECIFIC SPECS (Professional Grade)
  capacity        Int      @default(50)  // Max guests
  amenities       String[]               // e.g. ["AC", "Stage", "AV System", "Valet Parking"]
  address         String?
  city            String?
  state           String?
  zipCode         String?
  latitude        Float?
  longitude       Float?
  rules           String?                // Booking guidelines/rules
  
  // STATUS & VERIFICATION
  isApproved      Boolean  @default(false) // Admin approval
  isRentable      Boolean  @default(true)
  totalStock      Int      @default(1)
  image           String?                // Primary image
  gallery         String[]               // Additional images
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // RELATIONS
  lines           OrderLine[]
  availabilities  HallAvailability[]
  reviews         Review[]
  addOns          AddOn[]
  wishlist        WishlistItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([priceDaily])
  @@index([isApproved, isRentable])
  @@index([city])
}

// ==========================================
// 3. HALL AVAILABILITY & LOCKS (Prevents Double Bookings)
// ==========================================
model HallAvailability {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  bookingDate DateTime    // Specific date
  timeSlot    String      @default("FULL_DAY") // "FULL_DAY", "MORNING", "EVENING"
  status      String      @default("BLOCKED") // "BLOCKED", "MAINTENANCE"
  
  bookingId   String?     // Associated rental order
  createdAt   DateTime    @default(now())

  // CRITICAL: Database-level constraint to prevent overlapping bookings
  @@unique([productId, bookingDate, timeSlot])
  @@index([productId, bookingDate])
}

// ==========================================
// 4. RENTAL ORDER FLOW (Bookings)
// ==========================================
model RentalOrder {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  // STATUS FLOW: "QUOTATION", "PENDING", "CONFIRMED", "CANCELLED", "COMPLETED"
  status          String      @default("QUOTATION")
  
  // RENTAL PERIOD
  startDate       DateTime
  endDate         DateTime
  
  // FINANCIAL DETAILS
  totalAmount     Float
  securityDeposit Float       @default(0) 
  paymentMethod   String      @default("CREDIT_CARD")
  couponCode      String?
  discountAmount  Float       @default(0)
  
  // DELIVERY DETAILS
  deliveryAddress String?
  deliveryCharge  Float       @default(0)
  
  // SAAS COMMISSION FIELDS
  platformFee     Float       @default(0) // Platform's share
  vendorPayout    Float       @default(0) // Vendor's share
  payoutStatus    String      @default("PENDING") // "PENDING", "PAID", "HOLD"

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // RELATIONS
  invoice         Invoice?
  lines           OrderLine[]
  payments        Payment[]
  bookingAddOns   BookingAddOn[]

  @@index([userId])
  @@index([status])
}

model OrderLine {
  id          String      @id @default(uuid())
  orderId     String
  order       RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  
  quantity    Int
  price       Float       
}

// ==========================================
// 5. SERVICES & ADD-ONS (Upselling)
// ==========================================
model AddOn {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String         // e.g. "Catering per head", "Stage Decoration"
  price       Float
  description String?
  createdAt   DateTime       @default(now())
  
  bookings    BookingAddOn[]
}

model BookingAddOn {
  id        String      @id @default(uuid())
  orderId   String
  order     RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn       @relation(fields: [addOnId], references: [id])
  quantity  Int         @default(1)
  price     Float       // Snapshot of price at time of booking
}

// ==========================================
// 6. PAYMENTS & AUDIT TRAILS 
// ==========================================
model Invoice {
  id            String      @id @default(uuid())
  orderId       String      @unique
  order         RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  invoiceNumber String      @unique
  amount        Float
  status        String      @default("UNPAID") // "UNPAID", "PAID", "VOIDED"
  paymentMethod String?
  createdAt     DateTime    @default(now())
}

model Payment {
  id             String      @id @default(uuid())
  orderId        String
  order          RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  transactionId  String      @unique // Gateway Transaction Ref (Stripe, Razorpay, etc.)
  gateway        String      // "STRIPE", "RAZORPAY", "PAYPAL", "CASH"
  amount         Float
  currency       String      @default("INR")
  status         String      @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "REFUNDED"
  errorMessage   String?
  metadata       Json?       // Raw JSON from Gateway
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  refunds        Refund[]

  @@index([orderId])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  amount          Float
  reason          String?
  status          String   @default("PENDING") // "PENDING", "SUCCESS", "FAILED"
  gatewayRefundId String?  @unique
  
  createdAt       DateTime @default(now())
}

// ==========================================
// 7. RATINGS & REVIEWS 
// ==========================================
model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating      Int      // 1 to 5 Stars
  comment     String
  isVerified  Boolean  @default(false) // Checked true if customer rented this hall
  images      String[] // Customer review photos
  
  createdAt   DateTime @default(now())
  
  @@unique([productId, userId]) // One review per user per hall
  @@index([productId])
}

// ==========================================
// 8. SECURITY AUDIT LOGS
// ==========================================
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g. "APPROVED_HALL", "UPDATE_PRICE", "CANCEL_BOOKING"
  entityType  String   // e.g. "Product", "RentalOrder"
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ==========================================
// 9. PROMO COUPONS & GIFT CARDS
// ==========================================
model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // "PERCENTAGE" or "FIXED"
  discountValue Float
  isActive      Boolean  @default(true)
  expiryDate    DateTime?
  createdAt     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 10. VIRTUAL WALLET TRANSACTIONS
// ==========================================
model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // "CREDIT" or "DEBIT"
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ==========================================
// 11. OTP VERIFICATION MODEL FOR VENDOR SIGNUP
// ==========================================
model OtpVerification {
  id        String   @id @default(uuid())
  type      String   // "EMAIL" or "PHONE"
  value     String   // The email address or phone number
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([value])
}

// ==========================================
// 12. WISHLIST ITEMS
// ==========================================
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ==========================================
// 13. DYNAMIC NOTIFICATIONS
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // e.g. "OFFER", "SYSTEM", "TRANSACTION", "COMPLIANCE"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}